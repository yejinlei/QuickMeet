{
  "media": {
    "port": 8080,
    "signaling_port": 8081,
    "max_participants": 64,
    "idle_timeout_secs": 600
  },
  "network": {
    "cidrs": ["192.168.0.0/24", "10.0.0.0/8"],
    "bind_host": "192.168.0.10"
  },
  "logging": {
    "level": "info,webrtc=debug,qm_media=trace",
    "file_dir": "./logs",
    "json": true
  },
  "storage": {
    "data_dir": "./data/meetings",
    "encrypted": false
  },
  "ai": {
    "enabled": false,
    "base_url": "http://127.0.0.1:3000/v1",
    "timeout_ms": 30000
  },
  "cluster": {
    "server": "127.0.0.1",
    "port": 4222,
    "cluster_id": "quickmeet",
    "node_id": "node-1",
    "advertised_addr": "192.168.0.10:8080",
    "node_role": "full",
    "heartbeat_secs": 5,
    "unhealthy_misses": 2,
    "failover_target_secs": 10,
    "join_target_secs": 30,
    "request_timeout_secs": 3,
    "max_rooms_per_node": 64,
    "listener_capacity": 20000,
    "listener_fanout": 200
  }
}
