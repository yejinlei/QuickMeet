# QuickMeet 容器环境变量（QM-015）
#
# 由 docker-compose.yml 通过 env_file 加载。前缀 QM_，覆盖 config/default.toml
# 里的同名项。键名**只按第一个 `_` 分层**，后面的下划线属于字段名：
#   QM_MEDIA_PORT            -> media.port
#   QM_MEDIA_SIGNALING_PORT  -> media.signaling_port   （不是 media.signaling.port）
#   QM_NETWORK_BIND_HOST     -> network.bind_host
#
# 现场调参不需要改镜像或 toml，改这里重新 up 即可（验收标准 4）。
#
# 重要：Vec 类型的字段（如 network.cidrs）只能用 JSON 数组，
# **不能**用 QM_NETWORK_CIDRS_0/_1 这种索引写法。索引写法会立刻被拒绝
# （`环境变量 QM_NETWORK_CIDRS_0 指向未知的配置项 network.cidrs_0`），
# 而不是静默退化成默认值 —— 故意 fail fast，避免配置看起来生效其实没生效。
#
# 本文件只写**配置层真的认识**的键。写一个不认识的键会被直接拒绝启动
# （fail fast），所以扩展位一律先写成注释。

# ── 媒体 / 信令端口 ──────────────────────────────────────────────
# 媒体服务端口（Epic 全局约束 3：8080）
QM_MEDIA_PORT=8080
# 信令服务端口
QM_MEDIA_SIGNALING_PORT=8081

# ── 内网网段与绑定地址 ───────────────────────────────────────────
# 内网网段：JSON 数组形式。默认值只有 192.168.0.0/24（全局约束 3），
# 这里放宽到含 10.0.0.0/8，方便现场跨段部署；不需要就删掉第二项。
QM_NETWORK_CIDRS=["192.168.0.0/24","10.0.0.0/8"]
# 容器内绑定地址：容器要对外提供信令服务用 0.0.0.0。
# 注意 default.toml 里是 192.168.0.10（宿主机网卡地址），容器里没有这张卡，
# 所以这里必须覆盖，否则信令进程起不来。
QM_NETWORK_BIND_HOST=0.0.0.0

# ── 日志 / 数据 ──────────────────────────────────────────────────
# 日志级别。组合写法注意：逗号后面**不能有空格**，否则后面的 target 会被静默丢弃。
QM_LOGGING_LEVEL=info,webrtc=debug,qm_media=trace
# 日志目录（容器内路径，已挂载为 named volume）
QM_LOGGING_FILE_DIR=/opt/quickmeet/logs
QM_LOGGING_JSON=true

# 会议数据目录（容器内路径，已挂载为 named volume；数据不出容器，全局约束 5）
QM_STORAGE_DATA_DIR=/opt/quickmeet/data/meetings

# ── AI 能力（QM-013，服务未交付）────────────────────────────────
# 第一阶段默认关闭。开启前必须先把 base_url 指向**本地部署**的硅基流动接口
# （Epic 全局约束 4：禁止公网第三方 API）。当前仓库没有 AI 服务的代码，
# docker-compose.yml 里也没有 qm-ai 容器 —— 解开占位前先补齐服务与镜像。
QM_AI_ENABLED=false
QM_AI_BASE_URL=http://127.0.0.1:3000/v1
QM_AI_TIMEOUT_MS=30000
# 集群部署下 base_url 要写容器可达地址，例如
#   QM_AI_BASE_URL=http://<宿主机 IP>:3000/v1     # 见 docs/DEPLOYMENT.md「AI 服务接入」

# ── tracing 过滤 ─────────────────────────────────────────────────
# 供直接读 RUST_LOG 的入口使用；与 QM_LOGGING_LEVEL 同源
RUST_LOG=info,webrtc=debug,qm_media=trace

# ── 分布式集群（QM-006）──────────────────────────────────────────
# 每个 qm-media-* 实例靠这组变量区分自己是谁。docker-compose.yml 里
# 用环境变量覆盖下面的值，见各服务的 `environment:` 段。
#
# cluster.server 可以写 **IPv4** 或 **DNS 主机名**（比如容器名 qm-nats）。
# 写 IP 字面量时按 QM_NETWORK_CIDRS 校验（回环地址明确豁免，见 config.rs 的
# validate 注释）；写主机名时跳过网段校验 —— 容器服务名本来就不是 IP。
# 配置层唯一不放过的是畸形值：IPv6、`host:port`、带空格、以连字符开头结尾、
# 通配符等，都会被 fail fast 拒绝启动。
QM_CLUSTER_SERVER=qm-nats
QM_CLUSTER_PORT=4222

# 多机部署（NATS 跑在另一台机器上）时改成那台机器的内网 IP，例如
#   QM_CLUSTER_SERVER=192.168.0.30
# 单机部署下写 127.0.0.1 也仍然**合法**（回环地址被配置层豁免），但它指向的是
# 「容器自己的 loopback」——NATS 根本连不上，三个节点会一直退化单机、探针持续
# 返 503。所以容器部署必须写容器服务名 qm-nats。
QM_CLUSTER_CLUSTER_ID=quickmeet
QM_CLUSTER_NODE_ID=node-1
# 必须与本节点容器映射出的宿主机端口一致，旁听节点才回得到源。
QM_CLUSTER_ADVERTISED_ADDR=192.168.0.10:8080
QM_CLUSTER_NODE_ROLE=full
QM_CLUSTER_HEARTBEAT_SECS=5
QM_CLUSTER_UNHEALTHY_MISSES=2
QM_CLUSTER_FAILOVER_TARGET_SECS=10
QM_CLUSTER_JOIN_TARGET_SECS=30
QM_CLUSTER_REQUEST_TIMEOUT_SECS=3
QM_CLUSTER_MAX_ROOMS_PER_NODE=64
QM_CLUSTER_LISTENER_CAPACITY=20000
QM_CLUSTER_LISTENER_FANOUT=200

# ── 集群健康探针 ────────────────────────────────────────────────
# 集群模式不监听 8081，docker healthcheck 没有 HTTP 端点可探，
# 所以节点另起一个只读 /healthz（GET 返回节点状态 JSON，POST 返回 202）。
# GET 在 NATS 未连接时返回 503（不是 200）：探针只认 4xx/5xx，NATS 状态必须
# 进状态码，否则集群退化单机时容器照样报 healthy、验收变成假通过。
# 容器内固定 8090，docker-compose.yml 把它映射到宿主机 8091/8092/8093。
# compose 侧把 start_period 拉到 90s 是**故意的**：探针 503 意味着集群还没协调
# 好，start_period 太短会把启动期延迟算成判死、触发重启风暴。判死窗口（interval
# 5s × retries 3）与启动窗口因此解耦，稳态下节点 10s 左右就能被判 unhealthy。
# 注意：health_port 不能写 0 —— 配置层直接拒绝（探针是容器健康检查的唯一目标）。
QM_CLUSTER_HEALTH_PORT=8090

# ── ICE / TURN（QM-008，未交付）─────────────────────────────────
# 当前所有 ICE 候选都是 host / prflx / srflx，**没有 relay（TURN）路径**，
# 配置层也没有对应键。不要给 QM_ICE_TURN_URL 赋真值 —— 写了会被判成
# 未知配置项直接拒绝启动。等 QM-008 交付后再同时打开
# docker-compose.yml 里的 qm-turn 服务与这里的键。
# QM_ICE_TURN_URL=turn:192.168.0.30:3478
